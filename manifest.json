{
  "manifest_version": 3,
  "name": "Improved 42 Attendance",
  "version": "2.0.0",
  "description": "Improves the 42 Lyon attendance page: plan your month and follow your progress toward the goal of the month",
  "icons": { "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://attendance.42lyon.fr/me",
        "https://attendance.42lyon.fr/me?*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "improved-attendance@parad0xe",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}